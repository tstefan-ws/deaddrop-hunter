# deaddrop-hunter - optional environment variables
# Copy to .env (never commit .env) and fill in only what you have. Everything is optional:
# without keys the hunter still sweeps the chains whose free public RPCs allow it
# (Polygon, Ethereum, Arbitrum, Optimism, Base, Avalanche via Tenderly gateways).
# Format: KEY=value, one per line, no spaces around "=", no quotes needed.
# In GitHub Actions, add the same names under Settings -> Secrets and variables -> Actions.

# Etherscan V2 multichain API key (https://etherscan.io/apis). Used for tx/contract lookups
# on indexed chains. Note (measured 2026-10-19): the FREE plan does NOT cover BSC.
ETHERSCAN_API_KEY=

# Dune API key (https://dune.com/settings/api). Used for BSC event sweeps (table bnb.logs)
# and selector hunts (search transactions by 4-byte input prefix).
DUNE_API_KEY=

# TronGrid API key (https://www.trongrid.io/). Optional; raises the TronGrid rate limit
# for Tron account watches.
TRONGRID_API_KEY=

# Free-key RPC for BSC that allows topic-only eth_getLogs (NodeReal, Chainstack, Ankr...).
# Format: "<url>|<max_block_span>", e.g. https://bsc-mainnet.nodereal.io/v1/<key>|5000
DDH_RPC_BSC=

# Same for BSC testnet (ClearFake / UNC5142 used testnet contracts).
DDH_RPC_BSC_TESTNET=

# Solana RPC override (default: https://api.mainnet-beta.solana.com, heavily rate limited).
# e.g. a Helius / QuickNode / Alchemy URL with your key.
DDH_RPC_SOLANA=

# VirusTotal API key - reserved for IOC enrichment (future). Never used to visit IOCs.
VT_API_KEY=
